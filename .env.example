# Google Cloud
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI="True"
GOOGLE_GENAI_MODEL="gemini-2.5-flash"

# Agent Engine uses a regional runtime and a staging bucket for deployment artifacts.
AGENT_ENGINE_LOCATION="us-central1"
AGENT_ENGINE_STAGING_BUCKET="gs://your-agent-engine-staging-bucket"
AGENT_ENGINE_SERVICE_ACCOUNT="your-agent-runtime@your-gcp-project-id.iam.gserviceaccount.com"
AGENT_ENGINE_RESOURCE_NAME="projects/your-project-number/locations/us-central1/reasoningEngines/your-engine-id"
AGENT_ENGINE_SMOKE_FULL_SEARCH="False"
USE_AGENT_ENGINE="False"
PARALLEL_SECRET_ID="parallel-api-key"
PARALLEL_SECRET_VERSION="latest"

# Parallel Search remains server-side and must never use a NEXT_PUBLIC prefix.
PARALLEL_API_KEY="your-parallel-api-key"
REFERENCE_MIN_ARTIFACT_QUALITY=60
REFERENCE_MIN_MATCH_SCORE=55

# App
APP_ENV="development"
SECRET_KEY="change-me"
FRONTEND_ORIGINS="http://localhost:3000"
FIRESTORE_ENABLED="False"
REQUEST_TIMEOUT_SECONDS="280"
MAX_HTTP_REQUEST_BYTES="57671680"

# Next.js frontend
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
